\usefonttheme{professionalfonts}
\usepackage[light]{FiraSans} % Normal font is given by /firabook
\usepackage[T1]{fontenc}
\usepackage{tikz}
\usepackage{svg}
\usepackage{mathtools}
\usepackage{physics}
\usepackage[absolute,overlay]{textpos}

\ProvidesPackage{beamerthemeblob}

\mode<presentation>

% ══════════════════════════════════════════
% Make the template as barebones as possible
% ══════════════════════════════════════════
\setbeamersize{text margin left=0.1\paperwidth, text margin right=0.1\paperwidth}%
\setbeamertemplate{navigation symbols}{}

% ══════════════════════════════════════════
% Colors
% ══════════════════════════════════════════
% First define some cool colors
\definecolor{light}{HTML}{F7F7F7}
\definecolor{accent}{HTML}{7FBAC7}
\definecolor{dark}{HTML}{000000}

% Now set up the colors here 
\setbeamercolor{normal text}      {fg=dark}
\setbeamercolor{accent text}      {fg=accent}
\setbeamercolor{invert text}      {fg=light}
\setbeamercolor{contrast text}    {fg=dark}   % Text that contrasts the accent

% Title page colors 
\setbeamercolor{title}            {fg=dark}
\setbeamercolor{subtitle}         {fg=dark}
\setbeamercolor{author}           {fg=dark}
\setbeamercolor{institute}        {fg=dark}
\setbeamercolor{date}             {fg=dark}

% Background colors
\setbeamercolor{background}       {bg=light}
\setbeamercolor{invert background}{bg=dark}
\setbeamercolor{accent background}{bg=accent}
\setbeamercolor{background canvas}{bg=light}

% Colors for typical slide elements 
\setbeamercolor{frametitle}       {fg=dark}
\setbeamercolor{framesubtitle}    {fg=dark}
\setbeamercolor{section in head/foot}{fg=dark}
\setbeamercolor{structure}        {fg=accent}

% ══════════════════════════════════════════
% Fonts
% ══════════════════════════════════════════
% Title page fonts
\setbeamerfont{title}             {size=\Huge,          series=\bfseries}
\setbeamerfont{subtitle}          {size=\small,         series=\mdseries}
\setbeamerfont{institute}         {size=\scriptsize,    series=\bfseries, shape=\itshape}
\setbeamerfont{date}              {size=\scriptsize,    series=\mdseries, shape=\itshape}

% General frame fonts
\setbeamerfont{frametitle}        {size=\Large,         series=\bfseries}
\setbeamerfont{framesubtitle}     {size=\scriptsize,    series=\mdseries, shape=\itshape}

% Footer
\setbeamerfont{footline}          {size=\tiny}

% ══════════════════════════════════════════
% Title Page
% ══════════════════════════════════════════
\setbeamertemplate{title page}{
  \begin{minipage}[t][0.8\textheight][t]{0.7\textwidth}%
    \raggedright
    \vspace{0.15\textheight}%
    {\usebeamercolor[fg]{title}\color{fg}\usebeamerfont{title}\MakeUppercase{\inserttitle}\par}%
    \vfill
    {\usebeamercolor[fg]{subtitle}\color{fg}\usebeamerfont{subtitle}\insertsubtitle\par}%
    \vspace{0.5em}
    {\usebeamercolor[fg]{institute}\color{fg}\usebeamerfont{institute}\insertinstitute}
    {\usebeamercolor[fg]{date}\color{fg}\usebeamerfont{date}\insertdate\par}%
  \end{minipage}%
  \vspace{0.1\textheight}%
}

% ══════════════════════════════════════════
% Accent frame 
% ══════════════════════════════════════════
\newenvironment{accentframe}[2]{%
  \setbeamercolor{background canvas}{bg=accent}%
  \usebeamercolor{contrast text}
  \begin{frame}[plain]%
    \begin{minipage}[t][0.8\textheight][t]{\textwidth}%
      \vspace{0.1\paperwidth}%
      \begin{minipage}{\textwidth}
        \raggedright
        {\fontsize{48}{52}\selectfont\bfseries\color{fg}\MakeUppercase{#1}\par}%
        \vspace{1.2em}%
        {\large\color{fg}#2\par}%
      \end{minipage}%
    \end{minipage}
  \end{frame}%
}{}


% ══════════════════════════════════════════
% Titles and such
% ══════════════════════════════════════════
\setbeamertemplate{frametitle}{
  \nointerlineskip
  \begin{beamercolorbox}[wd=0.8\paperwidth, ht=0.17\paperheight]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle
    \ifx\insertframesubtitle\empty\else
      {\newline \usebeamercolor[fg]{framesubtitle}\color{fg}\usebeamerfont{framesubtitle}\insertframesubtitle}
    \fi
  \end{beamercolorbox}
}


% ══════════════════════════════════════════
%  Bottom Navigation stuff
% ══════════════════════════════════════════
\setbeamertemplate{footline height}{2.5em}
\setbeamertemplate{footline}{
  \begin{beamercolorbox}[wd=\paperwidth, ht=2.5ex, dp=1ex, center]{dark}
    \rule{\paperwidth}{0.1pt}
    \insertsectionnavigationhorizontal{0.8\paperwidth}{\hskip-.3cm}{\hskip-.3cm}
    \vfill
  \end{beamercolorbox}
}

\mode<all>
